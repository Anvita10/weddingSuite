# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (production)
CLIENT_ORIGIN=http://localhost:5173

# SQLite database file path
DB_PATH=./data/wedding-suite.db

# Simple shared-secret to protect the internal sales dashboard endpoint.
# Replace with a strong random value in production and send it as:
# Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-to-a-long-random-string

# WhatsApp business number the enquiry handoff link should open (E.164, no + or spaces)
WHATSAPP_NUMBER=911234567890

# Hotel identity — used in a couple of API responses
HOTEL_NAME="The Grand Aranya"
